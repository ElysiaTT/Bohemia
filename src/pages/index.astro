---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import RecordShowcase from '../components/RecordShowcase.astro';
import RecordTracklist from '../components/RecordTracklist.astro';
import { recordSides } from '../lib/record';
import site from '../data/site.json';
import notes from '../data/notes.json';
import { getPosts, withBase } from '../lib/posts';
import '../styles/record.css';
const posts = await getPosts();
const firstSide = recordSides[0];
---
<Base>
  <div class="record-home" data-record-home data-record-side={firstSide.id}>
    <section class="hero wrap">
      <div class="hero-copy">
        <div class="hero-eyebrow"><span class="eyebrow">A PERSONAL RHAPSODY</span><span class="growing"><i></i> ON AIR</span></div>
        <h1>{site.hero.line1}<br /><span>{site.hero.line2}</span></h1>
        <p class="hero-refrain" data-record-hero-title>{firstSide.artwork.title}</p>
        <p class="hero-description"><span class="hero-side-descriptor" data-record-side-descriptor>{firstSide.descriptor}</span><br /><span data-record-side-intent>{firstSide.intent}</span></p>
        <div class="hero-actions"><a class="button button-dark" href="#record-tracklist">探索专栏 <Icon name="arrow" size={18} /></a><a class="text-link" href={withBase('about/')}>认识一下 <Icon name="diagonal" size={15} /></a></div>
        <div class="hero-footnote"><span class="tiny-signal" aria-hidden="true">♫</span><span data-record-credit>{firstSide.artwork.credit}</span></div>
      </div>
      <RecordShowcase />
    </section>
    <output class="record-visually-hidden" id="record-status" role="status" aria-live="polite" aria-atomic="true">当前 {firstSide.side}，{firstSide.artwork.title}，{firstSide.tracks.length} 个专栏。</output>
    <div class="journal-divider wrap"><span><span class="little-spark" aria-hidden="true">✳</span> 每一份热爱，都有自己的声部。</span><span class="eyebrow">TWO SIDES OF THE SAME RECORD. <span aria-hidden="true">↘</span></span></div>
    <div class="journal-layout wrap" id="latest">
      <section class="journal-main">
        <div class="section-heading"><div><span class="eyebrow">THE TRACKLIST</span><h2>正在播放<span class="section-period">.</span></h2></div><a class="text-link" href={withBase('writing/')}>全部文章 <Icon name="arrow" size={16} /></a></div>
        <RecordTracklist posts={posts} />
        <a class="all-writing" href={withBase('writing/')}><span>还有一些想法，等你来翻。</span><span>浏览全部 {posts.length} 篇文章 <Icon name="arrow" size={17} /></span></a>
      </section>
      <aside class="journal-sidebar">
        <section class="about-card"><div class="about-card-top"><span class="eyebrow">BEHIND THE RECORD</span><span class="hand-wave" aria-hidden="true">✳</span></div><div class="avatar-mark" aria-hidden="true"><svg viewBox="0 0 50 50"><circle cx="25" cy="25" r="19" /><circle cx="25" cy="25" r="12" /><circle cx="25" cy="25" r="4" /></svg></div><h2>一张唱片，两种回响。</h2><p>一面记录世界如何运作，一面记录世界如何触动自己。</p><p>bohemia's rain，连接 Queen 的狂想与 X JAPAN 的雨。两面各有声部，热爱在这里相遇。</p><a class="text-link" href={withBase('about/')}>关于这两面唱片 <Icon name="diagonal" size={15} /></a><div class="about-card-bottom"><span class="status-dot"></span> 自由表达，保持热爱。</div></section>
        <section class="record-now-playing" aria-label="当前唱片面"><span class="eyebrow">NOW PLAYING</span><div class="record-now-playing-head"><span class="record-now-playing-disc" aria-hidden="true"></span><div><p data-now-playing-side>{firstSide.side}</p><h2 data-now-playing-name>{firstSide.artwork.title}</h2></div></div><div class="record-now-playing-caption"><span data-record-side-subtitle>{firstSide.name.toUpperCase()} / {firstSide.heading}</span><span data-now-playing-count>{firstSide.tracks.length} 个专栏</span></div><a class="text-link" href="#record-tracklist">查看当前专栏 <Icon name="arrow" size={15} /></a></section>
        <section class="sidebar-notes"><div class="sidebar-heading"><span class="eyebrow">LITTLE THINGS</span><h2>生活的切片</h2></div>{notes.slice(0, 2).map(note => <a class="mini-note" href={withBase(`notes/#${note.id}`)}><time>{note.date.replaceAll('-', '.')}</time><p>{note.content}</p><span>#{note.tag}</span></a>)}<a class="text-link" href={withBase('notes/')}>更多碎片 <Icon name="arrow" size={15} /></a></section>
        <section class="rss-card"><Icon name="rss" size={24} /><h2>把更新，交给 RSS。</h2><p>不追赶算法。用你喜欢的阅读器，慢慢读。</p><a href={withBase('rss.xml')} class="text-link">订阅这个小站 <Icon name="diagonal" size={15} /></a></section>
      </aside>
    </div>
    <section class="closing-note wrap"><span class="eyebrow">THE ENCORE</span><blockquote>生活，不止一种节奏。<br /><span>把热爱写下来，让不同的声音相遇。</span></blockquote><span class="closing-signature">Long live curiosity. <span aria-hidden="true">♫</span></span></section>
  </div>
  <script>
    import '../scripts/record';
  </script>
</Base>
