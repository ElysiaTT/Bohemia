---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Local from '../components/Local.astro';
import { withBase } from '../lib/posts';
---
<Base title="Track not found" titleZh="这支曲目还未录制" noindex><div class="wrap not-found"><span class="eyebrow">404 / TRACK NOT FOUND</span><div class="error-echo" aria-hidden="true">404<span>♫</span></div><Local as="h1" en="No echo on this page, yet." zh="这一页，暂时没有回声。" /><Local as="p" en="It may have moved, or may still be waiting to be written. Head home and choose another track." zh="它可能已经搬走，或者还没来得及写下。回到首页，换一支曲目继续读。" /><a class="button button-dark" href={withBase()}><Local en="Back home" zh="回到首页" /><Icon name="arrow" size={18} /></a></div></Base>
