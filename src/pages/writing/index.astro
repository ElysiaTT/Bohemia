---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import Local from '../../components/Local.astro';
import {categoryName, postCount, attributes} from '../../lib/i18n';
import { getPosts, categories } from '../../lib/posts';
const posts = await getPosts();
---
<Base title="Writing" titleZh="文章" description="All articles on technology, design, life and everyday reflections." descriptionZh="关于技术、设计、生活和日常思考的所有文章。">
  <div class="wrap page-wrap"><header class="page-heading"><span class="eyebrow">WORDS ALONG THE WAY</span><h1><Local en="Write it down. Let it resonate" zh="写下，才有回响" /><span>.</span></h1><Local as="p" en="Some thoughts put into words. Some answers still taking shape." zh="一些经过整理的思考，和一些还在生长的答案。" /></header><div class="filter-bar"><div class="filter-buttons" role="group" {...attributes({'aria-label': ['Filter articles by category', '按分类筛选文章']})}>{['全部', ...categories].map((category, index) => <button data-filter={category} aria-pressed={index === 0} class:list={{ selected: index === 0 }}><Local class="filter-label" en={categoryName(category, 'en')} zh={category} /><span>{category === '全部' ? posts.length : posts.filter(post => post.data.category === category).length}</span></button>)}</div><span data-filter-count class="filter-count">{postCount(posts.length, 'en')}</span></div><div class="writing-grid">{posts.map((post, index) => <div data-filter-item data-category={post.data.category}><PostCard post={post} index={index} /></div>)}</div><Local as="p" class="end-note" en="— More to write. More to discover. —" zh="— 写作未完，探索继续。 —" /></div>
</Base>
