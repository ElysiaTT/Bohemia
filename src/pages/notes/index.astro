---
import Base from '../../layouts/Base.astro';
import notes from '../../data/notes.json';
import Local from '../../components/Local.astro';
import {noteEnglish} from '../../data/english';
---
<Base title="Notes" titleZh="碎片" description="Passing thoughts, everyday discoveries and moments worth keeping." descriptionZh="未成篇的念头、日常的小发现，以及一些值得保留的瞬间。"><div class="wrap page-wrap notes-page"><header class="page-heading"><span class="eyebrow">SMALL NOTES, BIG LITTLE WORLD</span><h1><Local en="Life, between the lines" zh="生活，不止正文" /><span>.</span></h1><Local as="p" en="Passing thoughts and little pieces of everyday light." zh="未成篇的念头，和日常里偶然捡到的光。" /></header><div class="notes-intro"><span class="status-dot"></span><Local en="Notes along the way, whenever they arrive." zh="随手记录，不定期更新。" /><Local class="demo-label" en="Sample notes" zh="示例碎片" /></div><div class="notes-timeline">{notes.map(note => <article class="note-entry" id={note.id}><div class="note-date"><time datetime={note.date}>{note.date.replaceAll('-', '.')}</time><span aria-hidden="true">↘</span></div><div class="note-body"><Local as="p" en={noteEnglish[note.id]?.content || note.content} zh={note.content} /><Local class="note-tag" en={`#${noteEnglish[note.id]?.tag || note.tag}`} zh={`#${note.tag}`} /></div></article>)}</div><div class="notes-bottom"><Local en="There is meaning in the little things." zh="生活的意义，藏在这些小事情里。" /><span aria-hidden="true">✳</span></div></div></Base>
