---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Local from '../../components/Local.astro';
import {categoryName, postCount} from '../../lib/i18n';
import { getPosts, postUrl } from '../../lib/posts';
const posts = await getPosts();
const years = [...new Set(posts.map(post => post.data.date.getUTCFullYear()))];
---
<Base title="Archive" titleZh="归档" description="Follow the timeline and revisit every article." descriptionZh="沿着时间的线索，重访每一篇文章。"><div class="wrap page-wrap archive-page"><header class="page-heading"><span class="eyebrow">THE BACK CATALOGUE</span><h1><Local en="Time leaves a trace" zh="时间，会留下痕迹" /><span>.</span></h1><Local as="p" en="Follow the timeline. Listen again to the words along the way." zh="沿着时间的线索，重听每一次认真写下的声音。" /></header><div class="archive-summary"><Local en={`${postCount(posts.length, 'en')} so far`} zh={`目前留下 ${posts.length} 篇文字`} /><Local en="Still writing. Still growing." zh="写作未完，持续更新" /></div>{years.map(year => <section class="archive-year"><h2>{year}<Local en={postCount(posts.filter(post => post.data.date.getUTCFullYear() === year).length, 'en')} zh={`${posts.filter(post => post.data.date.getUTCFullYear() === year).length} 篇`} /></h2><div>{posts.filter(post => post.data.date.getUTCFullYear() === year).map(post => <a class="archive-row" href={postUrl(post)}><time datetime={post.data.date.toISOString()}>{String(post.data.date.getUTCMonth() + 1).padStart(2, '0')}.{String(post.data.date.getUTCDate()).padStart(2, '0')}</time><span class="archive-title">{post.data.title}</span><Local class="category-label" en={categoryName(post.data.category, 'en')} zh={post.data.category} /><Icon name="diagonal" size={18} /></a>)}</div></section>)}</div></Base>
