---
import Base from '../../layouts/Base.astro';
import Local from '../../components/Local.astro';
import {attributes, categoryName, localized} from '../../lib/i18n';
import { withBase } from '../../lib/posts';
import { articleCategories } from '../../lib/studio-content';
import { recordSides } from '../../lib/record';
import repository from '../../data/studio.json';
import '../../styles/studio.css';
const configuration = { repository, base: withBase(), index: withBase('studio/posts.json'), columns: recordSides.flatMap(side => side.tracks.map(track => ({ slug: track.slug, title: track.title, side: side.side }))) };
const credentialUrl = `https://github.com/settings/personal-access-tokens/new?${new URLSearchParams({ name: 'Bohemia writing room', description: 'Publish articles to Bohemia', target_name: repository.owner, expires_in: '30', contents: 'write' })}`;
---
<Base title="Writing room" titleZh="写作台" description="Write, preview and publish your next article on bohemia's rain." descriptionZh="在 bohemia's rain 写作、预览并发布你的下一篇文章。" noindex>
  <div class="studio-page wrap" id="writing-room" data-view="split">
    <header class="studio-heading">
      <div><p class="eyebrow">THE WRITING ROOM <span aria-hidden="true">/</span> BOHEMIA</p><h1><Local en={"Let a new voice find the page"} zh={"让新的声音，落在纸上"} /><span><Local en="." zh="。" /></span></h1><p><Local en={"Start something new, or let an old thought grow."} zh={"写一篇新的，或让旧文字继续生长。"} /></p></div>
      <button type="button" class="studio-connect-button" id="studio-connect"><span class="studio-connection-dot" aria-hidden="true"></span><span id="studio-connection-label"><Local en={"Connect GitHub"} zh={"连接 GitHub"} /></span><span aria-hidden="true">↗</span></button>
    </header>
    <noscript><p class="studio-notice"><Local en={"Enable JavaScript to use the writing room, or "} zh={"写作台需要开启 JavaScript。你也可以"} /><a href={`https://github.com/${repository.owner}/${repository.repo}/tree/${repository.branch}/src/content/posts`}><Local en={"edit articles on GitHub"} zh={"在 GitHub 编辑文章"} /></a><Local en="." zh="。" /></p></noscript>
    <div class="studio-notice" id="studio-message" role="status" aria-live="polite" hidden><p id="studio-message-text"></p><div id="studio-message-links"></div></div>
    <div class="studio-workspace">
      <aside class="studio-library" {...attributes({"aria-label": ["Article library", "文章库"]})}>
        <button type="button" class="button button-dark studio-new" id="studio-new"><span aria-hidden="true">＋</span> <Local en={"New article"} zh={"新建文章"} /></button>
        <div class="studio-library-tabs" role="group" {...attributes({"aria-label": ["Choose article source", "选择文章来源"]})}><button type="button" data-library="posts" aria-pressed="true"><Local en={"Blog articles"} zh={"博客文章"} /> <span id="studio-post-count">—</span></button><button type="button" data-library="drafts" aria-pressed="false"><Local en={"Local draft"} zh={"本机草稿"} /> <span id="studio-draft-count">0</span></button></div>
        <label class="studio-library-search"><span class="studio-sr-only"><Local en={"Search the writing room"} zh={"搜索写作台文章"} /></span><input type="search" id="studio-library-search" {...attributes({"placeholder": ["Find something you have written…", "找一段写过的文字…"]})} /></label>
        <div id="studio-library-list" class="studio-library-list" aria-live="polite"><p class="studio-library-empty"><Local en={"Loading articles…"} zh={"正在载入文章…"} /></p></div>
        <p class="studio-library-footnote" id="studio-library-note"><Local en={"Edit public articles offline. Connect GitHub to load repository drafts."} zh={"未连接时可编辑已公开文章；连接后也能载入仓库草稿。"} /></p>
        <a class="text-link studio-return" href={withBase()}><Local en={"Back to the blog"} zh={"回到博客"} /> <span aria-hidden="true">↗</span></a>
      </aside>
      <section class="studio-desk" {...attributes({"aria-label": ["Article editor", "文章编辑器"]})}>
        <div class="studio-actions"><div class="studio-save-state"><span class="eyebrow">ON THE DESK</span><p id="studio-save-state" role="status"><Local en={"A fresh page, waiting for your words."} zh={"新的一页，等你落笔。"} /></p></div><div class="studio-action-buttons"><button type="button" class="studio-secondary" id="studio-save"><Local en={"Save draft"} zh={"保存草稿"} /></button><button type="button" class="studio-secondary" id="studio-export"><Local en={"Export Markdown"} zh={"导出 Markdown"} /></button><button type="button" class="studio-primary" id="studio-publish"><Local en={"Publish to blog"} zh={"发布到博客"} /> <span aria-hidden="true">↗</span></button></div></div>
        <div class="studio-document-bar"><div><span class="studio-document-status" id="studio-document-status"><Local en={"New local draft"} zh={"本机新草稿"} /></span><span id="studio-document-hint"><Local en={"Write first. Decide when to publish later."} zh={"先写下来，再决定何时发布。"} /></span></div><details class="studio-management" id="studio-management"><summary><Local en={"Manage article"} zh={"管理文章"} /> <span aria-hidden="true">⌄</span></summary><div class="studio-management-menu"><a id="studio-open-article" href={withBase('writing/')} target="_blank" rel="noopener noreferrer" hidden><Local en={"View live article ↗"} zh={"查看线上文章 ↗"} /></a><button type="button" id="studio-unpublish" hidden><Local en={"Withdraw from blog"} zh={"从博客撤下"} /><small><Local en={"Save as a repository draft; republish later"} zh={"改为仓库草稿，之后可重新发布"} /></small></button><button type="button" id="studio-republish" hidden><Local en={"Republish to blog"} zh={"重新发布到博客"} /><small><Local en={"Publish current edits and update the site"} zh={"发布当前编辑内容，并更新网站"} /></small></button><button type="button" id="studio-delete-article" class="studio-danger-text" hidden><Local en={"Delete repository article"} zh={"删除仓库文章"} /><small><Local en={"Remove the article; keep images and Git history"} zh={"移除文章文件，保留图片与 Git 历史"} /></small></button><button type="button" id="studio-delete-draft"><Local en={"Remove local draft"} zh={"移除本机草稿"} /><small><Local en={"Clear this browser only; keep the live article"} zh={"只清理当前浏览器，不修改线上文章"} /></small></button></div></details></div>
        <form id="studio-form" novalidate>
          <fieldset class="studio-properties" id="studio-fields"><legend class="studio-sr-only"><Local en={"Article details and body"} zh={"文章信息与正文"} /></legend>
            <label class="studio-field studio-full studio-title-field"><Local en={"Article title"} zh={"文章标题"} /><input id="studio-title" name="title" {...attributes({"placeholder": ["Give this melody a name.", "给这段旋律，一个名字。"]})} maxlength="180" required /></label>
            <label class="studio-field"><Local en={"Article address"} zh={"文章地址"} /><input name="slug" id="studio-slug" placeholder="my-first-song" spellcheck="false" autocomplete="off" required /><small id="studio-slug-hint"><Local en={"Lowercase letters, numbers and hyphens. Fixed after publishing."} zh={"小写英文、数字和短横线；发布后地址固定。"} /></small></label>
            <label class="studio-field"><Local en={"Publication date"} zh={"发布日期"} /><input type="date" name="date" id="studio-date" required /></label>
            <label class="studio-field"><Local en={"Category"} zh={"文章分类"} /><select name="category" id="studio-category">{articleCategories.map(category => <option value={category} {...localized(categoryName(category, 'en'), category)}>{categoryName(category, 'en')}</option>)}</select></label>
            <label class="studio-field"><Local en={"Column"} zh={"所属专栏"} /><select name="column" id="studio-column"><option value="" {...localized("No column yet", "暂不收入专栏")}>No column yet</option>{recordSides.map(side => <optgroup label={`${side.side} · ${side.name}`}>{side.tracks.map(track => <option value={track.slug}>{track.title}</option>)}</optgroup>)}</select></label>
            <label class="studio-field studio-full"><Local en={"Summary"} zh={"文章摘要"} /><textarea name="description" id="studio-description" rows="2" maxlength="500" {...attributes({"placeholder": ["A sentence or two to introduce this article.", "用一两句话，告诉读者这篇文章写了什么。"]})} required></textarea></label>
            <div class="studio-cover-picker studio-full"><div class="studio-cover-thumbnail" aria-hidden="true"><img id="studio-cover-thumbnail" alt="" hidden /><span id="studio-cover-placeholder">B.<i>THE NEXT TRACK</i></span></div><div><div class="studio-cover-heading"><label for="studio-cover"><Local en={"Cover image"} zh={"文章封面"} /></label><label class="studio-upload" for="studio-cover-file"><Local en={"Choose image"} zh={"选择图片"} /> <span aria-hidden="true">↗</span></label><input type="file" id="studio-cover-file" class="studio-sr-only" accept="image/jpeg,image/png,image/webp,image/gif" {...attributes({"aria-label": ["Choose a cover image", "选择封面图片"]})} /></div><input name="cover" id="studio-cover" placeholder="images/your-cover.webp" spellcheck="false" {...attributes({"aria-label": ["Cover image path", "封面图片路径"]})} /><small><Local en={"JPG, PNG, WebP or GIF, up to 5 MB. Uploaded with the article when publishing."} zh={"支持 JPG、PNG、WebP、GIF，最多 5 MB。发布时随文章一起上传。"} /></small></div></div>
            <details class="studio-options studio-full"><summary><Local en={"Tags, image description and publishing options"} zh={"标签、图片说明与发布选项"} /></summary><div class="studio-options-grid"><label class="studio-field"><Local en={"Tags"} zh={"标签"} /><input name="tags" id="studio-tags" {...attributes({"placeholder": ["Separate with commas, e.g. photography, life", "用逗号分隔，如：摄影，日常"]})} /></label><label class="studio-field"><Local en={"Cover description"} zh={"封面说明"} /><input name="coverAlt" id="studio-cover-alt" {...attributes({"placeholder": ["Describe the image for readers.", "描述这张图片，方便读者理解。"]})} /></label><label class="studio-check"><input type="checkbox" name="draft" id="studio-repo-draft" /> <Local en={"Repository draft only; hidden from the blog"} zh={"仅作为仓库草稿，不显示在博客"} /></label><p class="studio-options-note"><Local en={"Local drafts stay in this browser. Draft files committed to a public repository remain visible on GitHub."} zh={"本机草稿只保存在当前浏览器。提交到公开仓库的草稿文件，在 GitHub 中仍可查看。"} /></p><label class="studio-check"><input type="checkbox" name="demo" id="studio-demo" /> <Local en={"Sample article; excluded from column counts"} zh={"这是示例文章，不计入正式专栏"} /></label><label class="studio-check"><input type="checkbox" name="featured" id="studio-featured" /> <Local en={"Keep the featured article flag"} zh={"保留精选文章标记"} /></label></div></details>
            <div class="studio-body-section studio-full">
              <div class="studio-body-heading"><div><span class="eyebrow">THE WORDS</span><h2><Local en={"Article body"} zh={"正文"} /><span><Local en="." zh="。" /></span></h2></div><div class="studio-view-controls" role="group" {...attributes({"aria-label": ["Writing view", "正文视图"]})}><button type="button" data-view="edit" aria-pressed="false"><Local en={"Edit"} zh={"编辑"} /></button><button type="button" data-view="split" aria-pressed="true"><Local en={"Split view"} zh={"并排预览"} /></button><button type="button" data-view="preview" aria-pressed="false"><Local en={"Reading preview"} zh={"阅读预览"} /></button></div></div>
              <div class="studio-writing-panes">
                <div class="studio-source-pane"><div class="studio-format-bar" role="group" {...attributes({"aria-label": ["Insert Markdown formatting", "插入正文格式"]})}><button type="button" data-format="heading" {...attributes({"title": ["Level 2 heading", "二级标题"]})}>H2</button><button type="button" data-format="bold" {...attributes({"title": ["Bold", "加粗"]})}><strong>B</strong></button><button type="button" data-format="quote" {...attributes({"title": ["Quote", "引用"]})}>“ ”</button><button type="button" data-format="link"><Local en={"Link"} zh={"链接"} /></button><button type="button" data-format="image"><Local en={"Image"} zh={"图片"} /></button><button type="button" data-format="code"><Local en={"Code"} zh={"代码"} /></button><span>MARKDOWN</span></div><label class="studio-sr-only" for="studio-body"><Local en={"Article body"} zh={"文章正文"} /></label><textarea id="studio-body" name="body" {...attributes({"placeholder": ["Begin with an idea, a moment or a song.\n\n## Your first heading\n\nWrite here in Markdown, or use the formatting buttons above.", "从一个想法、一段见闻，或一首歌开始。\n\n## 写下第一个小标题\n\n这里可以写正文。支持 Markdown，也可以使用上方按钮插入格式。"]})} spellcheck="false" required></textarea><div class="studio-body-bottom"><span><Local en={"Your writing saves automatically in this browser."} zh={"文字会自动保存在当前浏览器。"} /></span><span id="studio-word-count"><Local en={"0 characters"} zh={"0 字"} /></span></div></div>
                <article class="studio-preview" {...attributes({"aria-label": ["Article preview", "文章排版预览"]})}><p class="eyebrow studio-preview-label"><Local en={"A FIRST LISTEN / PREVIEW"} zh={"A FIRST LISTEN / 排版预览"} /></p><img id="studio-preview-cover" class="studio-preview-cover" alt="" hidden /><p class="studio-preview-meta" id="studio-preview-meta"></p><h2 id="studio-preview-title"><Local en={"Untitled"} zh={"未命名的作品"} /></h2><p class="studio-preview-description" id="studio-preview-description"></p><div class="prose" id="studio-preview-body" data-authored-content><p class="studio-preview-empty"><Local en={"Your words will take shape here."} zh={"你的文字，会在这里慢慢成形。"} /></p></div></article>
              </div>
            </div>
          </fieldset>
        </form>
        <div class="studio-desk-footer"><span>BOHEMIA <span aria-hidden="true">·</span> WRITE IN YOUR OWN KEY</span><button type="button" class="text-link" id="studio-reload" hidden><Local en={"Load latest repository version"} zh={"载入仓库最新版"} /> <span aria-hidden="true">↻</span></button></div>
      </section>
    </div>
  </div>
  <dialog class="studio-confirm" id="studio-confirm" aria-labelledby="studio-confirm-title" aria-describedby="studio-confirm-description"><form id="studio-confirm-form"><p class="eyebrow">MANAGE THIS TRACK</p><h2 id="studio-confirm-title"></h2><p id="studio-confirm-article" class="studio-confirm-article"></p><p id="studio-confirm-description"></p><p class="studio-confirm-note" id="studio-confirm-note"></p><label class="studio-field" id="studio-confirm-input-wrap" hidden><span><Local en={"Type the article address to confirm: "} zh={"输入文章地址以确认："} /><code id="studio-confirm-slug"></code></span><input type="text" id="studio-confirm-input" autocomplete="off" spellcheck="false" /></label><p id="studio-confirm-status" role="status" aria-live="polite"></p><div class="studio-confirm-buttons"><button type="button" class="studio-secondary" id="studio-confirm-cancel"><Local en={"Cancel"} zh={"取消"} /></button><button type="submit" class="studio-primary" id="studio-confirm-submit"></button></div></form></dialog>
  <dialog class="studio-auth" id="studio-auth" aria-labelledby="studio-auth-title"><div class="studio-auth-top"><span class="eyebrow">BACKSTAGE / GITHUB</span><button type="button" class="icon-button" id="studio-auth-close" {...attributes({"aria-label": ["Close GitHub connection", "关闭 GitHub 连接"]})}>×</button></div><h2 id="studio-auth-title"><Local en={"Let your words take the stage"} zh={"让文字，走上舞台"} /><span><Local en="." zh="。" /></span></h2><p><Local en={"Connect a GitHub account with write access to publish to "} zh={"连接你有写入权限的 GitHub 身份，即可把文章发布到"} /> <strong>ElysiaTT / Bohemia</strong><Local en="." zh="。" /></p><form id="studio-auth-form"><label class="studio-field"><Local en={"GitHub publishing token"} zh={"GitHub 发布凭据"} /><input type="password" id="studio-token" autocomplete="off" spellcheck="false" {...attributes({"placeholder": ["Paste a fine-grained personal access token", "粘贴 Fine-grained personal access token"]})} maxlength="512" required /></label><p class="studio-auth-note"><Local en={"The token stays in this page’s memory. Reconnect after refreshing or disconnecting. Tokens are never stored in drafts."} zh={"凭据只用于当前页面，刷新或断开后需重新连接。草稿中不会保存凭据。"} /></p><button type="submit" class="studio-primary" id="studio-auth-submit"><Local en={"Connect GitHub"} zh={"连接 GitHub"} /> <span aria-hidden="true">↗</span></button></form><p id="studio-auth-status" role="status"></p><details><summary><Local en={"First connection: create a publishing token"} zh={"首次连接：创建发布凭据"} /></summary><ol><li><a href={credentialUrl} target="_blank" rel="noopener noreferrer"><Local en={"Create a token on GitHub ↗"} zh={"在 GitHub 创建发布凭据 ↗"} /></a><Local en={". The name and permissions are prefilled."} zh={"，名称和权限已预填。"} /></li><li><Local en={"Under Repository access, choose "} zh={"在 Repository access 选择"} /> <strong>Only select repositories → Bohemia</strong><Local en="." zh="。" /></li><li><Local en={"Set Contents to "} zh={"确认 Contents 为"} /> <strong>Read and write</strong><Local en={", create the token and paste it above."} zh={"，创建后将凭据粘贴到上方。"} /></li></ol><a class="text-link" href="https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens" target="_blank" rel="noopener noreferrer"><Local en={"GitHub documentation ↗"} zh={"GitHub 官方说明 ↗"} /></a></details><div class="studio-auth-connected" id="studio-auth-connected" hidden><p><Local en={"Connected to Bohemia. Edit articles and load repository drafts."} zh={"已连接 Bohemia，可以编辑文章及载入仓库草稿。"} /></p><button type="button" class="studio-secondary" id="studio-sync"><Local en={"Sync article list"} zh={"同步文章列表"} /></button><button type="button" class="studio-secondary" id="studio-disconnect"><Local en={"Disconnect"} zh={"断开连接"} /></button></div></dialog>
  <script type="application/json" id="studio-config" set:html={JSON.stringify(configuration).replaceAll('<', '\u003c')} />
  <script>import '../../scripts/studio';</script>
</Base>
