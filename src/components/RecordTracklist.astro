---
import { recordSides, columnPosts } from '../lib/record';
import { withBase, type Post } from '../lib/posts';
interface Props { posts: Post[] }
const { posts } = Astro.props;
---
<section class="record-tracklist" id="record-tracklist" aria-label="当前唱片的专栏">
  <div class="record-programs">
    {recordSides.map((side, index) => <section class="record-program" data-record-panel={side.id} data-side-label={side.side} data-side-name={side.name} data-side-heading={side.heading} data-side-count={side.tracks.length} aria-labelledby={`${side.id}-program-title`} aria-hidden={index === 1 ? 'true' : 'false'} inert={index === 1}>
      <header class="record-program-header"><div><p class="eyebrow">{side.side} <span aria-hidden="true">/</span> {String(side.tracks.length).padStart(2, '0')} COLUMNS</p><h3 id={`${side.id}-program-title`}>{side.name}<span>.</span></h3><p class="record-program-heading">{side.heading}</p></div><span class="record-program-mark" aria-hidden="true">{index === 0 ? 'A' : 'B'}<i>33⅓<br />RPM</i></span></header>
      <p class="record-program-intro">{side.intro}</p>
      <ol class="record-columns">
        {side.tracks.map((track, trackIndex) => {
          const articles = columnPosts(posts, track.slug);
          return <li class="record-column"><span class="record-column-number" aria-hidden="true">{String(trackIndex + 1).padStart(2, '0')}</span><div class="record-column-copy"><h4>{articles.length ? <a href={withBase(`columns/${track.slug}/`)}>{track.title}<span aria-hidden="true"> ↗</span></a> : track.title}</h4><p>{track.note}</p>{articles.length ? <span class="record-column-available">{articles.length} 篇文章</span> : <span class="record-column-upcoming">即将更新</span>}</div></li>;
        })}
      </ol>
      <footer class="record-program-footer"><span>BOHEMIA <span aria-hidden="true">·</span> {side.side}</span><span>写作未完，唱片继续。</span></footer>
    </section>)}
  </div>
</section>
